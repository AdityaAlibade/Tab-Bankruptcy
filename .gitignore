# =========================================================
# Tab Bankruptcy — Root .gitignore
# =========================================================

# ── Python / Backend ──────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
*.egg

# Environment variables (never commit secrets)
.env
.env.*
*.local

# SQLite databases (auto-created on startup)
*.db
*.sqlite
*.sqlite3

# ── Node / JavaScript ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.vite/

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS ────────────────────────────────────────────────────
.DS_Store
ehthumbs.db
Desktop.ini
